# ══════════════════════════════════════════════════════════════════════
#  MailBrief — configuration
#  Copie ce fichier :  cp .env.example .env   puis remplies-le.
#  .env est ignoré par git : tes identifiants ne quittent jamais ta machine.
# ══════════════════════════════════════════════════════════════════════

# ── Boîte mail (IMAP) ─────────────────────────────────────────────────
# Choisis ton fournisseur : icloud, gmail, outlook, yahoo, free, orange,
#                           sfr, laposte, proton, custom
# Les hôtes et ports sont déjà configurés pour chacun.
IMAP_PRESET=icloud

IMAP_USER=
IMAP_PASSWORD=

# Pour proton : lance le client Proton Bridge et utilise le mot de passe
# de passe-affichage qu'il fournit (le port 1143 est déjà le bon).
# Pour un fournisseur non listé, mets IMAP_PRESET=custom puis :
#IMAP_HOST=imap.monfournisseur.fr
#IMAP_PORT=993

# Nom du dossier à lire (laisser INBOX)
IMAP_FOLDER=INBOX

# ── IA locale (Ollama) ────────────────────────────────────────────────
# Installer : https://ollama.com  puis  ollama pull qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ── Telegram ──────────────────────────────────────────────────────────
# 1. Parle à @BotFather → /newbot → copie le token
# 2. Envoie un message à ton bot, puis ouvre :
#    https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id": 123456}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Comportement ──────────────────────────────────────────────────────
# Fenêtre de recherche en heures (chevauchement assumé : le dédoublonnage
# se fait par UID, donc pas de doublon)
LOOKBACK_HOURS=26
# Nombre max de mails traités par run
MAX_MAILS=40
# Corps max d'un mail envoyé au modèle (caractères) — garde-le raisonnable,
# un prompt trop long déborde le contexte du modèle
MAX_BODY_CHARS=1500
# Fichier d'état (UID déjà traités)
STATE_PATH=data/state.json
# Fuseau horaire des dates affichées
TZ=Europe/Paris
